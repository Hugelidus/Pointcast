# Read only by `wxt build --mode e2e` (the build `pnpm e2e` tests; see src/build-env.ts).
# The e2e harness serves the Whisper model from node_modules' transformers.js cache on this
# port (playwright.config.ts), so tests never download it from Hugging Face.
WXT_MODEL_HOST=http://127.0.0.1:5541/
WXT_MODEL_PATH_TEMPLATE={model}/
